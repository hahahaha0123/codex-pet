<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 桌宠 · 小柯" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowActivated="False" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Window.Resources>
  <SolidColorBrush x:Key="SurfaceBackground" Color="#FF19252A"/>
  <SolidColorBrush x:Key="SurfaceBorder" Color="#FF3A5C50"/>
  <SolidColorBrush x:Key="SurfaceText" Color="#FFE8FFF5"/>
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
   <Setter Property="Foreground" Value="{StaticResource SurfaceText}"/>
   <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ContextMenu">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5" RenderOptions.ClearTypeHint="Enabled">
      <ScrollViewer CanContentScroll="True" MaxHeight="600" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
     </Border>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
   <Setter Property="Foreground" Value="{StaticResource SurfaceText}"/>
   <Setter Property="Padding" Value="6,7"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="MenuItem">
     <Grid>
      <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Check" Text="✓" Visibility="Hidden" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
        <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Hidden" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
       <Border Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="210" RenderOptions.ClearTypeHint="Enabled">
        <ScrollViewer CanContentScroll="True" MaxHeight="600" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/></Trigger>
      <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="DesktopRoot" Margin="14" Background="{x:Null}">
  <StackPanel Orientation="Horizontal">
   <Grid x:Name="Pet" Width="220" Height="260" Background="Transparent">
    <Ellipse Width="154" Height="20" VerticalAlignment="Bottom" Margin="0,0,0,14" Fill="#25000000"/>
    <Image x:Name="Sprite" Width="220" Height="228" VerticalAlignment="Bottom" Margin="0,0,0,22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.7">
     <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="PetScale"/><RotateTransform x:Name="PetTilt"/><TranslateTransform x:Name="PetMove"/></TransformGroup></Image.RenderTransform>
    </Image>
    <Border x:Name="Bubble" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="210" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="10,6" Visibility="Collapsed" RenderOptions.ClearTypeHint="Enabled">
     <TextBlock x:Name="Speech" Foreground="#D5FFF0" FontSize="14" TextWrapping="Wrap" Text="你好，我是小柯。"/>
    </Border>
   </Grid>
   <Grid x:Name="CardFrame" Width="300" Margin="2,47,0,27" VerticalAlignment="Top">
    <Border x:Name="CardShadow" CornerRadius="18" Background="{StaticResource SurfaceBackground}" IsHitTestVisible="False">
     <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
    </Border>
    <Border x:Name="Card" Padding="16,14" CornerRadius="18" BorderThickness="1" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceBorder}">
    <StackPanel x:Name="CardText" Background="{StaticResource SurfaceBackground}" RenderOptions.ClearTypeHint="Enabled">
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Project" Text="你的桌面编程搭子" Foreground="#8CA6A5" FontSize="14" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" x:Name="Status" Text="等待会话" Foreground="#88EBC6" FontSize="14"/></Grid>
     <Grid><TextBlock x:Name="ContextLabel" Text="上下文占用" Foreground="#A8BABC" FontSize="14"/><TextBlock x:Name="Context" Text="—" HorizontalAlignment="Right" Foreground="#9EF2CE" FontSize="14"/></Grid>
     <Grid Margin="0,10,0,0"><TextBlock x:Name="TpsLabel" Text="任务输出均速" Foreground="#A8BABC" FontSize="14"/><TextBlock x:Name="TaskTps" Text="— tok/s" HorizontalAlignment="Right" Foreground="#9EF2CE" FontSize="14"/></Grid>
     <Grid Margin="0,12,0,0"><TextBlock x:Name="CurrentLabel" Text="当前模型消耗" Foreground="#A8BABC" FontSize="14"/><TextBlock x:Name="Tokens" Text="—" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="14"/></Grid>
     <Grid Margin="0,5,0,0"><TextBlock x:Name="Model" Text="读取模型中" Foreground="#708887" FontSize="14" MaxWidth="142" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CurrentCost" Text="API 估算 —" Foreground="#8DB8A7" FontSize="14" HorizontalAlignment="Right"/></Grid>
     <Border x:Name="TotalToggle" Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="#35485B54" Cursor="Hand" Background="Transparent">
      <StackPanel><Grid><TextBlock x:Name="TotalLabel" Text="历史模型合计 ▾" Foreground="#A8BABC" FontSize="14"/><TextBlock x:Name="TotalTokens" Text="—" Foreground="#E7FFF4" FontSize="14" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="TotalCost" Text="API 估算 —" Foreground="#8DB8A7" FontSize="14" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <ScrollViewer x:Name="DetailsScroll" Visibility="Collapsed" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceBackground}"><StackPanel x:Name="ModelDetails" Visibility="Collapsed" Margin="0,12,0,0"/></ScrollViewer>
     <TextBlock x:Name="UsageScope" Text="本机历史 · API 估算 USD" Foreground="#708887" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </Grid>
</Window>
